<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_settings_pressed" />
            <stroke android:width="1dp" android:color="@color/vw_settings_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_settings_pressed" />
            <stroke android:width="1dp" android:color="@color/vw_settings_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vw_settings_surface" />
            <stroke android:width="1dp" android:color="@color/vw_settings_outline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
