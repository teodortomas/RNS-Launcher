<?xml version="1.0" encoding="utf-8"?>
<!--
  Text field on the settings-style screens (the drawer's search box). Same fill,
  outline and radius as a settings group, so the field reads as part of the
  surface rather than as a separate control. BrandChrome.inputBackground()
  swaps this for a brand-tinted selector at runtime.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/vw_settings_surface" />
    <stroke android:width="1dp" android:color="@color/vw_settings_outline" />
    <corners android:radius="10dp" />
</shape>
