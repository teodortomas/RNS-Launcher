<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor for one home key: the caption it shows and the icon it wears.
  Both are saved as they change, so there is no save button to find in the car.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/vw_settings_background">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/vw_settings_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/SettingsSection"
            android:text="@string/home_key_label" />

        <EditText
            android:id="@+id/labelInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/vw_settings_input"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/vw_settings_primary"
            android:textColorHint="@color/vw_settings_secondary"
            android:textSize="20sp" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/home_key_icon" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iconGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/vw_settings_divider" />

    <LinearLayout
        android:id="@+id/rowReset"
        style="@style/SettingsRow">

        <TextView
            style="@style/SettingsRowTitle"
            android:text="@string/home_key_reset" />
    </LinearLayout>
</LinearLayout>
