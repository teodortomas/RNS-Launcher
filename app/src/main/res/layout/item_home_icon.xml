<?xml version="1.0" encoding="utf-8"?>
<!--
  One icon in the key editor's grid: the drawing on a miniature key face, with the
  name of the drawing under it. The cell is a square that hugs the face, so the
  selection frame around an icon stays centred on it instead of stretching across
  the whole grid column. Face, glyph size and frame come from dimens.xml and
  IconAdapter, the same numbers the dashboard keys use.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/cellFrame"
        android:layout_width="@dimen/home_key_cell"
        android:layout_height="@dimen/home_key_cell"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/keyFace"
            android:layout_width="@dimen/home_key_face"
            android:layout_height="@dimen/home_key_face"
            android:layout_gravity="center">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconImage"
                android:layout_width="@dimen/home_key_glyph"
                android:layout_height="@dimen/home_key_glyph"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:tag="noTint" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/iconLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/vw_settings_secondary"
        android:textSize="10sp" />
</LinearLayout>
