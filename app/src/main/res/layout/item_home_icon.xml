<?xml version="1.0" encoding="utf-8"?>
<!--
  One icon in the key editor's grid. The cell is a square that hugs the key face,
  so the selection frame around an icon stays centred on it instead of stretching
  across the whole grid column. Face, glyph size and frame all come from
  dimens.xml and IconAdapter, the same numbers the dashboard keys use.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/cellFrame"
        android:layout_width="@dimen/home_key_cell"
        android:layout_height="@dimen/home_key_cell"
        android:layout_gravity="center"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/keyFace"
            android:layout_width="@dimen/home_key_face"
            android:layout_height="@dimen/home_key_face"
            android:layout_gravity="center">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iconImage"
                android:layout_width="@dimen/home_key_glyph"
                android:layout_height="@dimen/home_key_glyph"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:tag="noTint" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
