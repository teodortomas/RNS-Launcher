<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only reveal apps with a normal launcher entry to the app picker/drawer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Optional foreground location for the on-screen GPS speed display. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RadioLauncher">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.RadioLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME + DEFAULT is what makes Android offer this app as a launcher. -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          stateAlwaysHidden: the drawer opens on a grid of apps, not on the search
          field. Without it the search box takes first focus and the on-screen
          keyboard covers half the grid the moment the Apps tab is tapped.
        -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:parentActivityName=".HomeActivity" />


    </application>
</manifest>
